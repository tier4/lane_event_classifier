<launch>
  <arg name="param_path" default="$(find-pkg-share lane_event_classifier)/param/lane_event_classifier.param.yaml"/>

  <include file="$(find-pkg-share autoware_agnocast_wrapper)/launch/agnocast_env.launch.xml"/>

  <node pkg="lane_event_classifier" exec="lane_event_classifier_node" name="lane_event_classifier" output="screen">
    <param from="$(var param_path)"/>
    <env name="LD_PRELOAD" value="$(var ld_preload_value)"/>
  </node>
</launch>
